// Open-Source OCPP CMS - Prisma Schema
// Clean, production-ready schema for OCPP 1.6 Charge Point Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Admin user accounts
model User {
  id                  Int       @id @default(autoincrement())
  name                String?
  email               String    @unique
  password            String
  role                String    @default("admin")
  userType            String    @default("private")
  language            String    @default("en")
  companyName         String?
  companyId           Int?
  company             Company?  @relation(fields: [companyId], references: [id])
  address             String?
  phone               String?
  taxNumber           String?
  resetToken          String?
  resetTokenExpiry    DateTime?
  twoFactorEnabled    Boolean   @default(false)
  twoFactorMethod     String?
  twoFactorSecret     String?
  twoFactorCode       String?
  twoFactorCodeExpiry DateTime?
  emailVerified       Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  customRoleId                Int?
  customRole                  CustomRole?             @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  chargingStations            ChargingStation[]
  chargers                    Charger[]
  rfidUsers                   RfidUser[]
  chargeGroupUsers            ChargeGroupUser[]
  reimbursementContracts      ReimbursementContract[]
  vehicleEnergyProfile        VehicleEnergyProfile?
  vehicleContractCertificates VehicleContractCertificate[]
  auditLogs                   AuditLog[]
  invoices                    Invoice[]
  sepaMandates                SepaMandate[]
  reservations                Reservation[]
  webhookSubscriptions        WebhookSubscription[]
  scheduledChargings          ScheduledCharging[]
  pushSubscriptions           PushSubscription[]
  chargerSubscriptionPayments Charger[]               @relation("ChargerSubscriptionPayerUser")
  chargerTransactionReceivers Charger[]               @relation("ChargerTransactionReceiverUser")
  rfidHolders                 RfidUser[]              @relation("RfidHolderUser")
  rfidTransactionPayers       RfidUser[]              @relation("RfidTransactionPayerUser")
}

model Company {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  clientNumber String?  @unique
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?
  city         String?
  postalCode   String?
  country      String?  @default("Netherlands")
  taxNumber    String?
  kvkNumber    String?
  billingEmail String?
  status       String   @default("active") // "active", "pending", "suspended", "inactive"
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]
  mollieConfig MollieConfig?
  stripeConfig StripeConfig?
  invoices     Invoice[]
  sepaMandates SepaMandate[]
  chargingStations ChargingStation[]
  customRoles      CustomRole[]
  webhookSubscriptions WebhookSubscription[]
  ownedChargers               Charger[]  @relation("ChargerOwnerCompany")
  subscriptionPayerChargers   Charger[]  @relation("ChargerSubscriptionPayerCompany")
  transactionReceiverChargers Charger[]  @relation("ChargerTransactionReceiverCompany")
  rfidHolders                 RfidUser[] @relation("RfidHolderCompany")
  ownedRfidCards              RfidUser[] @relation("RfidOwnerCompany")
  rfidTransactionPayers       RfidUser[] @relation("RfidTransactionPayerCompany")
}

model MollieConfig {
  id        Int      @id @default(autoincrement())
  companyId Int?     @unique
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  apiKey    String
  profileId String?
  testMode  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StripeConfig {
  id             Int      @id @default(autoincrement())
  companyId      Int?     @unique
  company        Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  secretKey      String
  publishableKey String?
  webhookSecret  String?
  testMode       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Charging station / Site location
model ChargingStation {
  id                      Int      @id @default(autoincrement())
  station_name            String
  street_name             String
  city                    String
  state                   String?
  postal_code             String
  country                 String?
  latitude                Float
  longitude               Float
  on_site_person_name     String?
  on_site_contact_details String?
  emergency_contact       String?
  status                  String   @default("active")
  maxPower                Float? // Maximum allowed capacity in kW/Amps
  maxAmperage             Float?
  maxPhaseCurrent         Float?   @default(80.0)
  maxPhaseUnbalance       Float?   @default(16.0)
  owner_id                Int
  companyId               Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  isGroundPlanEnabled    Boolean                 @default(false)
  owner                  User                    @relation(fields: [owner_id], references: [id])
  company                Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  reimbursementContracts ReimbursementContract[]
  mediaCampaigns         MediaCampaign[]
  chargers               Charger[]
  parkingSpots           ParkingSpot[]
  roamingSessions        RoamingSession[]
  cdrs                   CDR[]
}

// Charging Point / Charger
model Charger {
  isHardwareAtRisk             Boolean           @default(false)
  consecutiveErrors            Int               @default(0)
  charger_id                   Int               @id @default(autoincrement())
  model                        String
  name                         String            @unique
  manufacturer                 String
  serial_number                String            @unique
  manufacturing_date           DateTime?
  power_capacity               Float
  status                       String            @default("offline")
  last_heartbeat               DateTime          @default("1970-01-01T00:00:00.000Z")
  firmware_version             String
  service_contacts             String
  thirdPartyBackendUrl         String?
  isPredictiveBalancingEnabled Boolean           @default(false)
  localSolarKwp                Float?
  owner_id                     Int
  ownerType                    String            @default("user") // "user" | "company"
  ownerCompanyId               Int?
  subscriptionPayerType        String?           // "user" | "company"
  subscriptionPayerUserId      Int?
  subscriptionPayerCompanyId   Int?
  transactionReceiverType      String?           // "user" | "company"
  transactionReceiverUserId    Int?
  transactionReceiverCompanyId Int?
  charging_station_id          Int
  requireAuth                  Boolean           @default(false)
  diagnostics                  DiagnosticEvent[]
  authPassword                 String?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  owner                      User              @relation(fields: [owner_id], references: [id])
  ownerCompany               Company?          @relation("ChargerOwnerCompany", fields: [ownerCompanyId], references: [id], onDelete: SetNull)
  subscriptionPayerUser      User?             @relation("ChargerSubscriptionPayerUser", fields: [subscriptionPayerUserId], references: [id], onDelete: SetNull)
  subscriptionPayerCompany   Company?          @relation("ChargerSubscriptionPayerCompany", fields: [subscriptionPayerCompanyId], references: [id], onDelete: SetNull)
  transactionReceiverUser    User?             @relation("ChargerTransactionReceiverUser", fields: [transactionReceiverUserId], references: [id], onDelete: SetNull)
  transactionReceiverCompany Company?          @relation("ChargerTransactionReceiverCompany", fields: [transactionReceiverCompanyId], references: [id], onDelete: SetNull)
  chargingStation            ChargingStation   @relation(fields: [charging_station_id], references: [id], onDelete: Cascade)

  chargerAlerts ChargerAlert[]
  evses         Evse[]
  transactions  Transaction[]
  ocppLogs      OcppLog[]
  rfidSessions  RfidSession[]
  tariffs       Tariff[]

  chargeGroupId Int?
  chargeGroup   ChargeGroup? @relation(fields: [chargeGroupId], references: [id], onDelete: SetNull)

  configurations   ChargerConfiguration[]
  chargingProfiles ChargingProfile[]
  meterValues      MeterValue[]
  deviceComponents DeviceComponent[]

  // Combined / Paired 2-Socket Charger support
  isCombined                   Boolean           @default(false)
  pairedChargerId              Int?
  pairedRole                   String?           // "primary" | "secondary"
  pairedCharger                Charger?          @relation("PairedChargers", fields: [pairedChargerId], references: [charger_id], onDelete: SetNull)
  pairedWithChargers           Charger[]         @relation("PairedChargers")

  // Third-Party Backend Straight-Through Connection Mode
  isStraightThroughProxy       Boolean           @default(false)

  // Public vs Private Charger Access
  isPublic                     Boolean           @default(false)

  quirkProfileId Int?
  quirkProfile   ChargerQuirkProfile?   @relation(fields: [quirkProfileId], references: [id], onDelete: SetNull)
  schedulePlans  ChargingSchedulePlan[]
  installedCertificates InstalledCertificate[]
  certificateRequests   CertificateRequest[]
  localAuthList         LocalAuthList?
  reservations          Reservation[]
  scheduledChargings    ScheduledCharging[]
  anomalyEvents         AnomalyEvent[]
  healthScores          ComponentHealthScore[]

  // Phase Commutation (1-Phase ⇄ 3-Phase Dynamic Switching)
  phaseCommutationSupported    Boolean           @default(false)
  currentPhaseMode             String            @default("3-Phase") // "1-Phase" | "3-Phase"
  lastPhaseSwitchAt            DateTime?

  productId      Int?
  product        SubscriptionProduct?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  eichrechtRecords EichrechtRecord[]
  autoHealExecutions AutoHealExecution[]
}

model ChargerQuirkProfile {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  rules       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chargers Charger[]
}

model Evse {
  id         Int      @id @default(autoincrement())
  evse_id    Int
  charger_id Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  charger    Charger     @relation(fields: [charger_id], references: [charger_id], onDelete: Cascade)
  connectors Connector[]

  @@unique([charger_id, evse_id])
}

// Charge connector (multiple per evse)
model Connector {
  connector_id   Int      @id @default(autoincrement())
  connector_name String   @default("Channel 1")
  status         String
  current_type   String
  max_current    Float?
  max_power      Float?
  mac_address    String?
  format         String   @default("SOCKET")
  max_voltage    Float    @default(400)
  phaseConnection String   @default("L1-L2-L3")
  supportsPhaseSwitching Boolean @default(false)
  evse_id        Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  evse          Evse         @relation(fields: [evse_id], references: [id], onDelete: Cascade)
  parkingSpotId Int?         @unique
  parkingSpot   ParkingSpot? @relation(fields: [parkingSpotId], references: [id], onDelete: SetNull)
}

// RFID tag whitelist
model RfidUser {
  rfid_user_id Int      @id @default(autoincrement())
  rfid_tag     String   @unique
  external_id  String?
  name         String   @default("")
  email        String?
  phone        String?
  company_name String?
  address      String?
  type         String   @default("postpaid")
  cardScope    String   @default("Roaming") // "Roaming" | "Local"
  active       Boolean  @default(true)
  owner_id                   Int
  ownerType                  String                       @default("user") // "user" | "company"
  ownerCompanyId             Int?
  holderType                 String?                      @default("user") // "user" | "company"
  holderUserId               Int?
  holderCompanyId            Int?
  transactionPayerType       String?                      // "user" | "company"
  transactionPayerUserId     Int?
  transactionPayerCompanyId  Int?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  owner                   User                         @relation(fields: [owner_id], references: [id])
  ownerCompany            Company?                     @relation("RfidOwnerCompany", fields: [ownerCompanyId], references: [id], onDelete: SetNull)
  holderUser              User?                        @relation("RfidHolderUser", fields: [holderUserId], references: [id], onDelete: SetNull)
  holderCompany           Company?                     @relation("RfidHolderCompany", fields: [holderCompanyId], references: [id], onDelete: SetNull)
  transactionPayerUser    User?                        @relation("RfidTransactionPayerUser", fields: [transactionPayerUserId], references: [id], onDelete: SetNull)
  transactionPayerCompany Company?                     @relation("RfidTransactionPayerCompany", fields: [transactionPayerCompanyId], references: [id], onDelete: SetNull)
  rfidSessions            RfidSession[]
  transactions           Transaction[]
  vehicleEnergyProfile   VehicleEnergyProfile?
  vehicleCertificates    VehicleContractCertificate[]
  reimbursementContracts ReimbursementContract[]
  reservations           Reservation[]
}

// RFID post-paid charging sessions
model RfidSession {
  id                Int       @id @default(autoincrement())
  transactionId     String    @unique
  rfidUserId        Int
  charger_id        Int
  connectorName     String
  charger           Charger   @relation(fields: [charger_id], references: [charger_id], onDelete: Cascade)
  startTime         DateTime  @default(now())
  endTime           DateTime?
  initialMeterValue Float?
  finalMeterValue   Float?
  energyConsumed    Float     @default(0)
  currentPower      Float?    @default(0)
  soc               Float?
  current           Float?
  voltage           Float?
  tariffRate        Float?
  amountDue         Float     @default(0)
  status            String    @default("charging")
  stopReason        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  rfidUser RfidUser @relation(fields: [rfidUserId], references: [rfid_user_id])
}

// Simplified transaction tracking
model Transaction {
  id                Int       @id @default(autoincrement())
  transactionId     String
  connectorName     String
  charger_id        Int
  charger           Charger   @relation(fields: [charger_id], references: [charger_id], onDelete: Cascade)
  rfidUserId        Int?
  rfidUser          RfidUser? @relation(fields: [rfidUserId], references: [rfid_user_id])
  startTime         DateTime  @default(now())
  endTime           DateTime?
  initialMeterValue Float?
  finalMeterValue   Float?
  energyConsumed    Float     @default(0)
  dischargeLimit    Float?
  currentDirection  String    @default("Charging")
  currentPower      Float?    @default(0)
  soc               Float?
  current           Float?
  voltage           Float?
  status            String    @default("initiated")
  stopReason        String?
  idTag             String?
  totalCost         Float?
  invoiceId         Int?
  invoice           Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  eichrechtRecord   EichrechtRecord?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([charger_id])
  @@index([status])
  @@index([status, startTime])
  @@index([invoiceId])
}

// OCPP message logging for debugging
model OcppLog {
  id            Int      @id @default(autoincrement())
  chargerId     Int
  charger       Charger  @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)
  transactionId String?
  timestamp     DateTime @default(now())
  direction     String
  message       String

  @@index([chargerId])
  @@index([chargerId, timestamp])
}

// Optional: Tariff for pricing
model Tariff {
  tariff_id        Int      @id @default(autoincrement())
  tariff_name      String   @unique
  charge           Float
  electricity_rate Float
  tariffType       String   @default("FIXED") // "FIXED" or "DYNAMIC_EPEX"
  country          String? // "BE" or "NL"
  dynamicProvider  String?  @default("EnergyZero") // "EnergyZero", "Energy-Charts"
  markupPerKwh     Float?
  taxPercentage    Float?
  fixedFeePerMonth Float?
  time_fee         Float?   @default(0)
  idle_fee         Float?   @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  chargers               Charger[]
  chargeGroupUsers       ChargeGroupUser[]
  reimbursementContracts ReimbursementContract[]
}

model EpexSpotPrice {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime
  country     String
  pricePerMwh Float
  provider    String   @default("EnergyZero")

  @@unique([timestamp, country, provider])
}

// Payment Transactions (for Stripe, Mollie, etc.)
model PaymentTransaction {
  id              Int      @id @default(autoincrement())
  transactionId   String   @unique
  provider        String // "mollie", etc., etc.
  paymentIntentId String? // ID from provider
  amount          Float
  currency        String   @default("EUR")
  status          String   @default("pending") // "pending", "succeeded", "failed"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// OCPI Endpoints for roaming
model OcpiEndpoint {
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  token     String // Token used for auth
  version   String   @default("2.2.1")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChargeGroup {
  id                  Int      @id @default(autoincrement())
  name                String
  description         String?
  maxPower            Float? // Maximum allowed capacity in kW/Amps
  maxAmperage         Float?
  maxPhaseCurrent     Float    @default(80.0)
  maxPhaseUnbalance   Float    @default(16.0)
  phaseUnbalanceLimit Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  chargers       Charger[]
  users          ChargeGroupUser[]
  mediaCampaigns MediaCampaign[]
}

model ChargerConfiguration {
  id        Int     @id @default(autoincrement())
  chargerId Int
  key       String
  value     String
  readonly  Boolean @default(false)
  charger   Charger @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)

  @@unique([chargerId, key])
}

model ChargeGroupUser {
  chargeGroupId Int
  userId        Int
  tariffId      Int?
  chargeGroup   ChargeGroup @relation(fields: [chargeGroupId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tariff        Tariff?     @relation(fields: [tariffId], references: [tariff_id])

  @@id([chargeGroupId, userId])
}

// Unrecognized or rejected OCPP connections
model UnrecognizedConnection {
  id            Int      @id @default(autoincrement())
  chargePointId String
  ipAddress     String?
  reason        String
  timestamp     DateTime @default(now())
}

// OCPP Smart Charging Profiles applied to chargers
model ChargingProfile {
  id                     Int       @id @default(autoincrement())
  chargerId              Int
  connectorId            Int
  chargingProfileId      Int
  transactionId          String?
  stackLevel             Int
  chargingProfilePurpose String // e.g. "ChargePointMaxProfile", "TxDefaultProfile", "TxProfile"
  chargingProfileKind    String // e.g. "Absolute", "Recurring", "Relative"
  recurrencyKind         String?
  validFrom              DateTime?
  validTo                DateTime?
  chargingSchedule       Json // Store the complex charging schedule object
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  charger Charger @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)

  @@unique([chargerId, chargingProfileId])
}

// OICP Endpoints for roaming
model OicpEndpoint {
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  token     String // Token used for auth
  version   String   @default("2.3.0")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Smart Charging Profiles applied to chargers
model ConfigurationProfile {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ConfigurationProfileItem[]
}

model ConfigurationProfileItem {
  id        Int                  @id @default(autoincrement())
  profileId Int
  key       String
  value     String
  profile   ConfigurationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, key])
}

model MeterValue {
  id            Int      @id @default(autoincrement())
  transactionId String
  chargerId     Int
  connectorId   Int?
  energy        Float?
  power         Float?
  soc           Float?
  current       Float?
  voltage       Float?
  current_L1    Float?
  current_L2    Float?
  current_L3    Float?
  voltage_L1    Float?
  voltage_L2    Float?
  voltage_L3    Float?
  timestamp     DateTime @default(now())

  charger Charger @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)

  @@index([transactionId])
  @@index([chargerId])
  @@index([chargerId, timestamp])
}

model DeviceComponent {
  id          Int     @id @default(autoincrement())
  chargerId   Int
  name        String
  instance    String?
  evseId      Int?
  connectorId Int?

  charger   Charger          @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)
  variables DeviceVariable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeviceVariable {
  id          Int                 @id @default(autoincrement())
  componentId Int
  name        String
  instance    String?
  component   DeviceComponent     @relation(fields: [componentId], references: [id], onDelete: Cascade)
  attributes  VariableAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VariableAttribute {
  id         Int     @id @default(autoincrement())
  variableId Int
  type       String  @default("Actual")
  value      String?
  mutability String?
  persistent Boolean @default(false)
  constant   Boolean @default(false)

  variable DeviceVariable @relation(fields: [variableId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variableId, type])
}

model ChargerAlert {
  id          Int      @id @default(autoincrement())
  chargerId   Int
  eventId     Int
  timestamp   DateTime
  severity    Int
  component   String
  variable    String
  actualValue String

  charger Charger @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// Mail Configuration for SMTP
model MailConfig {
  id          Int      @id @default(autoincrement())
  host        String
  port        Int
  username    String
  password    String
  fromAddress String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Mail Templates for different types of emails
model MailTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  language  String   @default("en")
  @@unique([type, language])
  subject   String
  bodyHtml  String
  bodyText  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Global system settings (e.g., API keys)
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ParkingSpot {
  id        Int      @id @default(autoincrement())
  stationId Int
  name      String
  type      String   @default("spot") // spot, line, rectangle
  fillColor String?
  lineColor String?
  lineWidth Float?
  x         Float    @default(0)
  y         Float    @default(0)
  width     Float    @default(100)
  height    Float    @default(200)
  rotation  Float    @default(0)
  metadata  Json?    // Electrical topology properties: sourceNodeId, targetNodeId, maxCapacityKw, maxCurrentAmps, cableType, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  station   ChargingStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  connector Connector?

  @@index([stationId])
}

model ChargingSchedulePlan {
  id            Int      @id @default(autoincrement())
  chargerId     Int
  timestamp     DateTime
  predictedAmps Float
  solarForecast Float?
  epexPrice     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  charger Charger @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)

  @@index([chargerId, timestamp])
}

// Diagnostics Event for Auto-Healing
model DiagnosticEvent {
  id          Int      @id @default(autoincrement())
  chargerId   Int
  connectorId Int?
  type        String // e.g., "HighTemperature", "FaultedState", "CommunicationError"
  description String
  timestamp   DateTime @default(now())
  resolved    Boolean  @default(false)

  charger Charger @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)

  @@index([chargerId])
  @@index([timestamp])
}

// Auto-Heal Rule definition
model AutoHealRule {
  id               Int      @id @default(autoincrement())
  triggerType      String // e.g., "Status", "MeterValue"
  triggerCondition String // e.g., "Faulted", "Temperature > 80"
  actionCommand    String // e.g., "SoftReset", "HardReset", "UnlockConnector"
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Vendor-Specific Auto-Healing Playbook Definition
model AutoHealPlaybook {
  id               Int                 @id @default(autoincrement())
  name             String              @unique
  vendor           String // "Alfen" | "EVBox" | "ABB" | "Schneider" | "Kempower" | "Generic"
  modelPattern     String? // Optional glob/regex for specific hardware models
  errorCodePattern String // Regex or error codes pattern (e.g. "Err_023|LockTimeout|GroundFailure")
  severity         String              @default("HIGH") // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  category         String              @default("Hardware") // "ConnectorLock" | "PowerElectronics" | "Communications" | "Thermal" | "GridFault" | "Firmware" | "General"
  description      String?
  isActive         Boolean             @default(true)
  priority         Int                 @default(100) // Higher priority evaluates first
  cooldownMinutes  Int                 @default(15) // Debounce period to prevent continuous re-triggering
  maxRetries       Int                 @default(3)
  steps            Json // Array of { stepNumber: number, action: string, params?: any, delayMs?: number, description?: string }
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  executions       AutoHealExecution[]

  @@index([vendor])
  @@index([isActive])
}

// Execution Record of an Auto-Healing Playbook
model AutoHealExecution {
  id               Int               @id @default(autoincrement())
  playbookId       Int?
  chargerId        Int
  connectorId      Int?
  triggerReason    String
  matchedErrorCode String?
  vendor           String?
  status           String            @default("PENDING") // "PENDING" | "RUNNING" | "COMPLETED" | "FAILED" | "ABORTED"
  currentStep      Int               @default(0)
  totalSteps       Int               @default(0)
  stepLogs         Json              @default("[]") // Array of { stepNumber, action, timestamp, status, details, response }
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  errorMessage     String?
  isResolved       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  playbook         AutoHealPlaybook? @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  charger          Charger           @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)

  @@index([chargerId])
  @@index([playbookId])
  @@index([status])
  @@index([startedAt])
}

model VehicleEnergyProfile {
  id              Int   @id @default(autoincrement())
  userId          Int?  @unique
  rfidUserId      Int?  @unique
  minSocThreshold Float @default(40.0) // Minimum SoC percentage
  batteryCapacity Float?

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rfidUser RfidUser? @relation(fields: [rfidUserId], references: [rfid_user_id], onDelete: Cascade)
}

// Reimbursement Contract
model ReimbursementContract {
  id         Int    @id @default(autoincrement())
  userId     Int // Employee
  rfidUserId Int // Company Fleet RFID (idTag)
  stationId  Int // Employee's Home Charger
  tariffId   Int // Employee's specific home energy rate or fixed government rate
  iban       String // Employee's IBAN

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rfidUser RfidUser        @relation(fields: [rfidUserId], references: [rfid_user_id], onDelete: Cascade)
  station  ChargingStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  tariff   Tariff          @relation(fields: [tariffId], references: [tariff_id], onDelete: Cascade)

  ledgers ReimbursementLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, rfidUserId, stationId])
}

// Reimbursement Ledger
model ReimbursementLedger {
  id          Int       @id @default(autoincrement())
  contractId  Int
  month       Int
  year        Int
  totalKwh    Float
  totalAmount Float
  status      String    @default("pending") // "pending", "exported", "paid"
  exportedAt  DateTime?

  contract ReimbursementContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, month, year])
}

// ISO 15118 Vehicle Contract Certificate for Plug & Charge
model VehicleContractCertificate {
  id                Int       @id @default(autoincrement())
  emaid             String    @unique
  macAddress        String?
  contractCert      String?   @db.Text
  contractCertChain String?   @db.Text
  status            String    @default("Valid") // "Valid", "Expired", "Revoked"
  expirationDate    DateTime
  issuerNameHash    String?
  issuerKeyHash     String?
  serialNumber      String?
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  rfidUser             RfidUser? @relation(fields: [rfidUserRfid_user_id], references: [rfid_user_id])
  rfidUserRfid_user_id Int?

  @@index([issuerNameHash, issuerKeyHash, serialNumber])
}

// Installed X.509 Certificates on Chargers (CSMS / V2G / Sub-CA / EVSE)
model InstalledCertificate {
  id                  Int       @id @default(autoincrement())
  chargerId           Int
  certificateType     String    // "V2GRootCertificate", "MORootCertificate", "CSMSRootCertificate", "ManufacturerRootCertificate"
  certificateHashData Json?     // { hashAlgorithm, issuerNameHash, issuerKeyHash, serialNumber }
  certificatePem      String?   @db.Text
  serialNumber        String?
  validFrom           DateTime?
  validTo             DateTime?
  status              String    @default("Accepted") // "Accepted", "Rejected", "Failed"
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  charger             Charger   @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)

  @@index([chargerId])
}

model MediaCampaign {
  id              Int      @id @default(autoincrement())
  name            String
  assetUrl        String
  displayDuration Int      @default(30) // in seconds
  targetModels    Json     // Array of charger model names or patterns
  stationId       Int?
  chargeGroupId   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station     ChargingStation? @relation(fields: [stationId], references: [id], onDelete: Cascade)
  chargeGroup ChargeGroup?     @relation(fields: [chargeGroupId], references: [id], onDelete: Cascade)
}

// Roaming Partner (eMSP)
model RoamingPartner {
  id              Int      @id @default(autoincrement())
  name            String
  type            String   @default("eMSP") // "eMSP" or "Hubject/Clearinghouse"
  apiCredentials  String?
  wholesaleMarkup Float    @default(0) // Percentage or fixed
  clearingFee     Float    @default(0) // Clearinghouse fees
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  roamingSessions RoamingSession[]
  cdrs            CDR[]
}

// Roaming Session
model RoamingSession {
  id              Int      @id @default(autoincrement())
  partnerId       Int
  partner         RoamingPartner @relation(fields: [partnerId], references: [id])
  stationId       Int
  station         ChargingStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  transactionId   String   @unique
  startTime       DateTime @default(now())
  endTime         DateTime?
  energyConsumed  Float    @default(0)
  wholesaleCost   Float    @default(0) // Cost billed to foreign MSP
  baseCost        Float    @default(0) // Internal energy cost
  netMargin       Float    @default(0) // wholesaleCost - baseCost
  status          String   @default("active") // "active", "completed", "settled"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Charge Detail Record (CDR)
model CDR {
  id              Int      @id @default(autoincrement())
  cdrId           String   @unique
  partnerId       Int
  partner         RoamingPartner @relation(fields: [partnerId], references: [id])
  stationId       Int
  station         ChargingStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  transactionId   String
  startTime       DateTime
  endTime         DateTime
  totalEnergy     Float
  totalTime       Float
  totalCost       Float
  currency        String   @default("EUR")
  status          String   @default("pending") // "pending", "sent", "settled"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Settings for Hardware at Risk monitoring
model HardwareAtRiskSetting {
  id                      Int      @id @default(autoincrement())
  isEnabled               Boolean  @default(false)
  offlineThresholdMinutes Int      @default(60)
  criticalErrorCodeLimit  Int      @default(5)
  autoHealAttemptLimit    Int      @default(3)
  notifyAdminEmail        Boolean  @default(false)
  adminEmailAddress       String?
  updatedAt               DateTime @updatedAt
}

// Immutable Security & Operational Audit Log Ledger (SEC-02)
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g. "CHARGER_RESET", "TARIFF_UPDATE", "UNLOCK_CONNECTOR", "STATION_CREATE", "REMOTE_START", "WEBHOOK_PROCESSED"
  target    String   // e.g. "Charger", "Tariff", "ChargingStation", "Transaction", "Webhook"
  targetId  String?  // e.g. "101", "STA-10", "TX-12345"
  payload   Json?    // mutation payload or diff
  ip        String   @default("127.0.0.1")
  userAgent String?
  createdAt DateTime @default(now())
}

// Automated Monthly Invoicing & Multi-Tax Engine (FIN-01)
model Invoice {
  id             Int           @id @default(autoincrement())
  invoiceNumber  String        @unique
  companyId      Int?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId         Int?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipientName  String?
  recipientEmail String?
  billingAddress String?
  taxNumber      String?
  country        String?       @default("NL")
  periodStart    DateTime?
  periodEnd      DateTime?
  subtotal       Float
  vatAmount      Float
  totalAmount    Float
  vatRate        Float         @default(21.0)
  currency       String        @default("EUR")
  status         String        @default("issued")
  pdfUrl         String?
  dueDate        DateTime
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items          InvoiceItem[]
  transactions   Transaction[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  vatRate     Float    @default(21.0)
  vatAmount   Float    @default(0)
  amount      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
}

// SEPA Direct Debit Mandate & ISO 20022 Direct Debit (FIN-02)
model SepaMandate {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId     Int?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  debtorName    String
  iban          String
  bic           String?
  mandateRef    String   @unique
  signatureDate DateTime @default(now())
  mandateType   String   @default("CORE") // "CORE" or "B2B"
  sequenceType  String   @default("RCUR") // "FRST", "RCUR", "FNAL", "OOFF"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
}

// Local Authorization List for Offline Resilience (OCPP SendLocalList)
model LocalAuthList {
  id           Int                  @id @default(autoincrement())
  chargerId    Int                  @unique
  listVersion  Int                  @default(0)
  status       String               @default("Synchronized") // "Synchronized", "Outdated", "Syncing", "Failed"
  lastSyncedAt DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  charger      Charger              @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)
  entries      LocalAuthListEntry[]

  @@index([chargerId])
}

model LocalAuthListEntry {
  id              Int           @id @default(autoincrement())
  localAuthListId Int
  idTag           String
  status          String        @default("Accepted") // "Accepted", "Blocked", "Expired", "Invalid", "ConcurrentTx"
  parentIdTag     String?
  expiryDate      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  localAuthList   LocalAuthList @relation(fields: [localAuthListId], references: [id], onDelete: Cascade)

  @@unique([localAuthListId, idTag])
  @@index([localAuthListId])
  @@index([idTag])
}

// EVSE Connector Reservations (OCPP ReserveNow / CancelReservation)
model Reservation {
  id            Int       @id @default(autoincrement())
  reservationId Int       @unique
  chargerId     Int
  connectorId   Int
  idTag         String
  parentIdTag   String?
  expiryDate    DateTime
  status        String    @default("Active") // "Active", "Expired", "Consumed", "Cancelled"
  userId        Int?
  rfidUserId    Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  charger       Charger   @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  rfidUser      RfidUser? @relation(fields: [rfidUserId], references: [rfid_user_id], onDelete: SetNull)

  @@index([chargerId])
  @@index([status])
  @@index([expiryDate])
  @@index([idTag])
}

// Certificate Signing Requests (CSR) for OCPP 1.6 Security & OCPP 2.0.1/2.1 PKI
model CertificateRequest {
  id                Int      @id @default(autoincrement())
  chargerId         Int
  certificateType   String   // "V2GRootCertificate", "MORootCertificate", "CSMSRootCertificate", "ManufacturerRootCertificate", "ChargeStationCertificate"
  csr               String   @db.Text
  status            String   @default("Pending") // "Pending", "Signed", "Rejected", "Installed"
  signedCertificate String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  charger           Charger  @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)

  @@index([chargerId])
  @@index([status])
}

// Custom Role & Policy-Based Access Control (SEC-03)
model CustomRole {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  color       String    @default("#3f78e0")
  companyId   Int?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  isSystem    Boolean   @default(false)
  permissions Json      // Array of strings, e.g. ["chargers.view", "chargers.control", "tariffs.manage"]
  siteScopes  Json?     // Array of station / chargeGroup IDs for site-level restrictions
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       User[]

  @@index([companyId])
  @@index([slug])
}

// Outbound Webhook Subscriptions (INT-01)
model WebhookSubscription {
  id              Int               @id @default(autoincrement())
  companyId       Int?
  company         Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          Int?
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  name            String
  targetUrl       String
  secret          String            // HMAC-SHA256 signing secret
  events          Json              // Array of event topics, e.g. ["transaction.started", "connector.faulted"]
  isActive        Boolean           @default(true)
  customHeaders   Json?             // Optional key-value header dictionary
  failureCount    Int               @default(0)
  lastTriggeredAt DateTime?
  lastStatusCode  Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  deliveries      WebhookDelivery[]

  @@index([companyId])
  @@index([isActive])
}

// Webhook Delivery Logs & Retry Ledger (INT-02)
model WebhookDelivery {
  id                 Int                 @id @default(autoincrement())
  subscriptionId     Int
  subscription       WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event              String
  payload            Json
  requestHeaders     Json?
  responseCode       Int?
  responseBody       String?             @db.Text
  responseDurationMs Int?
  status             String              @default("Pending") // "Success", "Failed", "Retrying"
  attempts           Int                 @default(1)
  nextRetryAt        DateTime?
  error              String?
  createdAt          DateTime            @default(now())
  deliveredAt        DateTime?

  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}

// Scheduled Charging Plans & Smart Charging Windows
model ScheduledCharging {
  id             Int       @id @default(autoincrement())
  userId         Int?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chargerId      Int
  charger        Charger   @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)
  connectorId    Int       @default(1)
  idTag          String?   // RFID card idTag for authorization

  name           String    @default("Scheduled Charge")
  scheduleType   String    @default("time_window") // "time_window", "departure_time", "cheapest_tariff", "solar_optimal"
  recurrence     String    @default("once") // "once", "daily", "weekdays", "weekends", "custom"
  daysOfWeek     Json?     // Array of strings, e.g. ["mon", "tue", "wed", "thu", "fri"]

  // Time parameters
  startTime      String?   // "23:00" (HH:mm)
  stopTime       String?   // "07:00" (HH:mm)
  startDate      DateTime? // for one-time schedule
  stopDate       DateTime? // for one-time schedule
  departureTime  String?   // "07:30" (HH:mm) for departure time mode

  // Power & Energy parameters
  maxCurrentAmps Float     @default(16.0)
  maxPowerKw     Float     @default(11.0)
  targetSoc      Float?    // e.g. 80.0 (%)
  energyLimitKwh Float?    // e.g. 35.0 (kWh)

  // Execution state
  status         String    @default("Active") // "Active", "Paused", "Executing", "Completed", "Cancelled"
  lastExecutedAt DateTime?
  lastStatus     String?   // "Started", "ProfileApplied", "Stopped", "CompletedCycle", "Failed", "Idle"
  lastError      String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([chargerId])
  @@index([status])
}

// Firmware Repository & Binary Distribution (DEV-04)
model FirmwareFile {
  id           Int      @id @default(autoincrement())
  name         String
  version      String
  manufacturer String?
  model        String?
  chargerId    Int?
  filename     String
  fileUrl      String
  fileSize     Int      // Size in bytes
  checksum     String?  // SHA-256 Checksum
  releaseNotes String?
  uploadedBy   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([model])
  @@index([manufacturer])
  @@index([chargerId])
}

// Platform Subscription Products & Charger Recurring Fees (FIN-03)
model SubscriptionProduct {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?  // Line item description on generated invoices
  category         String   @default("public") // "private", "business", "public"
  price            Float    // Base recurring fee excl. VAT
  currency         String   @default("EUR")
  paymentFrequency String   @default("monthly") // "monthly", "quarterly", "yearly"
  vatRate          Float    @default(21.0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  chargers         Charger[]

  @@index([category])
  @@index([isActive])
}

// 15-Minute Intraday Continuous & Real-Time Imbalance Settlement Prices
model EnergyMarketPrice {
  id             Int      @id @default(autoincrement())
  timestamp      DateTime
  country        String   // "NL", "BE", "DE", "FR"
  marketType     String   // "DAY_AHEAD", "INTRADAY_15MIN", "IMBALANCE_REALTIME"
  priceType      String   @default("settled") // "settled", "forecast", "imbalance_pos", "imbalance_neg"
  pricePerMwh    Float
  provider       String   @default("EnergyZero") // "EnergyZero", "ENTSO-E", "TenneT", "Elia"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([timestamp, country, marketType, provider])
  @@index([country, marketType, timestamp])
  @@index([timestamp])
}

// Eichrecht / OCMF Legal Metrology Signed Meter Records (German/Austrian MessEG compliance)
model EichrechtRecord {
  id                 Int       @id @default(autoincrement())
  transactionDbId    Int       @unique
  transactionId      String    // OCPP Transaction ID string
  chargerId          Int
  meterSerialNumber  String
  publicKey          String    @db.Text
  ocmfPayload        String    @db.Text
  meterStartKwh      Float
  meterStopKwh       Float
  totalKwh           Float
  signature          String    @db.Text
  signatureAlgorithm String    @default("ECDSA-secp256r1-SHA256")
  isVerified         Boolean   @default(false)
  verificationError  String?
  verifiedAt         DateTime?
  xmlProof           String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  transaction        Transaction @relation(fields: [transactionDbId], references: [id], onDelete: Cascade)
  charger            Charger     @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)

  @@index([chargerId])
  @@index([transactionId])
  @@index([meterSerialNumber])
  @@index([isVerified])
}

// Web Push VAPID Subscriptions for Mobile PWA & Push Notifications
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Component Health Score & Remaining Useful Life (RUL) tracking
model ComponentHealthScore {
  id                        Int      @id @default(autoincrement())
  chargerId                 Int
  connectorId               Int      @default(1)
  componentType             String   // "CONNECTOR_PIN_L1" | "CONNECTOR_PIN_L2" | "CONNECTOR_PIN_L3" | "CABLE_ASSEMBLY" | "COOLING_LOOP" | "POWER_ELECTRONICS"
  healthScore               Float    @default(100.0) // 100.0 (Optimal) -> 0.0 (Critical)
  contactResistanceMilliOhms Float?
  voltageDropVolts          Float?
  thdCurrentPct             Float?
  thermalSlopeDegPerMin     Float?
  rulDays                   Int?     // Estimated Remaining Useful Life in days
  status                    String   @default("HEALTHY") // "HEALTHY" | "DEGRADING" | "AT_RISK" | "CRITICAL"
  lastEvaluatedAt           DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  charger Charger @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)

  @@unique([chargerId, connectorId, componentType])
  @@index([chargerId, healthScore])
  @@index([status])
}

// High-Frequency Anomaly Event Log
model AnomalyEvent {
  id                 Int       @id @default(autoincrement())
  chargerId          Int
  connectorId        Int?      @default(1)
  transactionId      String?
  anomalyType        String    // "CONTACT_RESISTANCE_SPIKE" | "PHASE_IMBALANCE" | "CABLE_WEAR_HARMONICS" | "COOLING_DEGRADATION" | "VOLTAGE_SAG_ANOMALY"
  severity           String    @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  anomalyScore       Float     // 0.0 to 1.0
  confidence         Float     @default(0.9)
  rootCause          String
  affectedPhase      String?   // "L1" | "L2" | "L3" | "ALL"
  metrics            Json?     // Extracted feature payload
  telemetrySnapshot  Json?     // Sliding window data points
  deratingApplied    Boolean   @default(false)
  deratedLimitAmps   Float?
  resolved           Boolean   @default(false)
  resolvedAt         DateTime?
  resolutionNotes    String?
  createdAt          DateTime  @default(now())

  charger Charger @relation(fields: [chargerId], references: [charger_id], onDelete: Cascade)

  @@index([chargerId, resolved])
  @@index([severity])
  @@index([createdAt])
}





